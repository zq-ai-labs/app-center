{
  "name": "@bkms/app-center",
  "version": "0.1.0",
  "description": "BKMS 应用中心：应用目录、应用登记与 AI 对话集成",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "assets/icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node scripts/build-demo.mjs && node demo/server.mjs",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "packageManager": "pnpm@11.7.0"
}

{
  "name": "@bkms/app-center",
  "version": "0.1.0",
  "description": "BKMS 应用中心：应用目录、应用登记与 AI 对话集成",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node scripts/build-demo.mjs && node demo/server.mjs"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-locale"],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.7.0"
}
